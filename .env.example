# Copy this file to .env and fill in real values. .env is git-ignored; never commit secrets.

# Alpaca paper-trading API key ID (from the paper dashboard). Required.
ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXX
# Alpaca paper-trading secret key. Required.
ALPACA_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# true = paper endpoint (default); false only switches account reads to live. There is no order code.
ALPACA_PAPER=true

# Twelve Data API key. Optional; enables the fallback data source and close cross-validation.
TWELVEDATA_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Email backend: smtp, resend or file. Required.
EMAIL_BACKEND=smtp
# Sender address. Required.
EMAIL_FROM=you@example.com
# Comma-separated recipient addresses. Required.
EMAIL_TO=you@example.com,partner@example.com

# SMTP host (when EMAIL_BACKEND=smtp). Default smtp.gmail.com.
SMTP_HOST=smtp.gmail.com
# SMTP port (when EMAIL_BACKEND=smtp). Default 587 (STARTTLS); use 465 with SMTP_USE_SSL=true.
SMTP_PORT=587
# SMTP login user name (when EMAIL_BACKEND=smtp).
SMTP_USERNAME=you@example.com
# SMTP password; for Gmail a 16-character app password (when EMAIL_BACKEND=smtp).
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# Use implicit SSL instead of STARTTLS (when EMAIL_BACKEND=smtp). Default false.
SMTP_USE_SSL=false

# Resend API key (when EMAIL_BACKEND=resend).
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Path to a Google service-account JSON key. Optional; with GOOGLE_SHEET_ID enables Sheets push.
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# Target Google Sheet ID. Optional; with GOOGLE_SERVICE_ACCOUNT_FILE enables Sheets push.
GOOGLE_SHEET_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Data directory for the SQLite file and dry-run outputs. Default ./data.
UT_DATA_DIR=./data
# TOML configuration file. When unset: ./config/default.toml if it exists, else the default
# config shipped inside the package. Uncomment only to point at your own copy.
# UT_CONFIG_FILE=config/default.toml
# Exchange timezone used for the schedule and as-of resolution. Default America/New_York.
UT_TIMEZONE=America/New_York
# Log level: DEBUG, INFO, WARNING, ERROR. Default INFO.
LOG_LEVEL=INFO
# Log line format: text (human readable) or json (one JSON object per line). Default text.
LOG_FORMAT=text
